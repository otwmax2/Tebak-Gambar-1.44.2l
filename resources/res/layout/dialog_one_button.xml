<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background_inset"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayoutWrapperContent"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_level_pilih_soal"
            android:textStyle="bold"
            android:textColor="@color/color_dark_green_1"
            android:gravity="center_horizontal"
            android:id="@+id/textViewJudulPertanyaan"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_reset_ask"
            android:layout_below="@+id/textViewJudulPertanyaan"
            custom:typeface="dimbo"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_below="@+id/textViewQuestion">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/textViewButton1"
                android:background="@drawable/selector_button_green_1"
                android:paddingLeft="24dp"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingRight="24dp"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_row_padding_right"
                android:text="@string/label_decline"
                android:maxLines="1"
                custom:typeface="dimbo"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imageViewClose"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="-20dp"
        android:layout_marginRight="-20dp"
        android:src="@drawable/ic_dialog_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
