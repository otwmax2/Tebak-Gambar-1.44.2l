<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_sticker_campaign_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/header_normal"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linearLayoutBottom"
        android:layout_below="@+id/relativeLayoutTop">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingTop="32dp"
            android:paddingRight="48dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mainImageView"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="0dp"
                android:layout_height="40dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:paddingLeft="8dp"
                android:paddingTop="16dp"
                android:paddingRight="8dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/textViewTermTitle"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:typeface="dimbo"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="20sp"
                    android:id="@+id/textViewTermPoints"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typeface="dimbo"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayoutBottom"
        android:background="@color/color_dark_green_1"
        android:padding="12dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/buttonShareWrapper"
            android:tag="binding_5"
            android:padding="1dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/buttonShare"
                android:background="@drawable/selector_button_dark_transparent"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-2dp"
                android:layout_marginTop="-2dp"
                android:layout_marginRight="-2dp"
                android:layout_marginBottom="-2dp">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/textViewShare"
                    android:tag="binding_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typeface="dimbo"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:layout_width="20dp"
            android:layout_height="0dp"/>
        <RelativeLayout
            android:id="@+id/buttonClaimWrapper"
            android:tag="binding_7"
            android:padding="1dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/buttonClaim"
                android:background="@drawable/selector_button_dark_transparent"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-2dp"
                android:layout_marginTop="-2dp"
                android:layout_marginRight="-2dp"
                android:layout_marginBottom="-2dp">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="24sp"
                    android:gravity="center"
                    android:id="@+id/textViewClaim"
                    android:tag="binding_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typeface="dimbo"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/relativeLayoutLoading"
        android:tag="binding_9"
        android:background="@color/color_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relativeLayoutTop">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_loading"
            android:layout_centerInParent="true"
            app:typeface="dimbo"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relativeLayoutFailed"
        android:tag="binding_10"
        android:background="@color/color_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relativeLayoutTop">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_edittext_jawaban"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:tag="binding_11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:typeface="dimbo"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonTryAgain"
                android:tag="binding_12"
                android:background="@drawable/selector_button_orange_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_button_margin_top"
                android:text="@string/button_try_again"
                android:maxLines="1"
                app:innerShadowColor="@color/color_yellow1"
                app:innerShadowRadius="2"
                app:strokeJoinStyle="bevel"
                app:typeface="dimbo"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
