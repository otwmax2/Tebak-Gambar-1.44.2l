<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayoutTop"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_top_bar"
        android:layout_alignParentTop="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_logo"
            android:textStyle="bold"
            android:textColor="@color/color_yellow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_margin_right_top_logo"
            android:text="@string/label_tebakgambar"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            custom:innerShadowColor="@color/color_yellow1"
            custom:strokeColor="@color/color_black"
            custom:strokeJoinStyle="bevel"
            custom:typeface="dimbo"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_admob_height"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linearLayoutWrapperButton"
        android:background="@color/color_dark_green_1"
        android:paddingLeft="@dimen/size_padding_wrapper_content"
        android:paddingTop="@dimen/size_padding_button_bottom"
        android:paddingRight="@dimen/size_padding_wrapper_content"
        android:paddingBottom="@dimen/size_padding_button_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frameAds">
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button"
            android:textColor="@color/color_white"
            android:id="@+id/buttonLeaderboard"
            android:background="@drawable/selector_button_red_1"
            android:paddingTop="@dimen/size_padding_top_button_main"
            android:paddingBottom="@dimen/size_padding_bottom_button_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_margin_sosial_media"
            android:text="@string/button_leaderboard"
            android:layout_weight="1"
            custom:typeface="avengeance"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button"
            android:textColor="@color/color_white"
            android:id="@+id/buttonKirimSoal"
            android:background="@drawable/selector_button_blue_1"
            android:paddingTop="@dimen/size_padding_top_button_main"
            android:paddingBottom="@dimen/size_padding_bottom_button_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_sosial_media"
            android:text="@string/button_kirim_soal"
            android:layout_weight="1"
            custom:typeface="avengeance"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayoutWrapperLabelShare"
        android:background="@color/color_yellow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/linearLayoutWrapperButton">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_edittext_jawaban"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_bonus_score"
            custom:typeface="dimbo"/>
        <ImageView
            android:id="@+id/imageViewShareFacebook"
            android:layout_width="@dimen/size_help_question_width"
            android:layout_height="@dimen/size_help_question_width"
            android:layout_marginLeft="@dimen/size_margin_top_button_main"
            android:src="@drawable/selector_btn_fb"
            android:layout_marginStart="@dimen/size_margin_top_button_main"/>
        <ImageView
            android:id="@+id/imageViewShareTwitter"
            android:layout_width="@dimen/size_help_question_width"
            android:layout_height="@dimen/size_help_question_width"
            android:layout_marginLeft="@dimen/size_margin_top_button_main"
            android:src="@drawable/selector_btn_twitter"
            android:layout_marginStart="@dimen/size_margin_top_button_main"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollViewWrapperSoal"
        android:paddingTop="5dp"
        android:scrollbars="vertical"
        android:fadingEdge="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@+id/linearLayoutWrapperLabelShare"
        android:layout_below="@+id/relativeLayoutTop"
        android:layout_centerHorizontal="true"
        android:fadeScrollbars="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/linearLayoutWrapperSoal"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:paddingBottom="@dimen/size_layout_margin_top_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_button_height_number">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_button"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/textViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_margin_top_button_main"
                android:text="@string/label_mainlagi_duelgambar"
                android:layout_centerVertical="true"
                custom:typeface="dimbo"/>
            <com.tebakgambar.component.CustomImageView
                android:id="@+id/imageViewAvatar"
                android:layout_width="@dimen/size_layout_yellow_dialog_height"
                android:layout_height="@dimen/size_layout_yellow_dialog_height"
                android:layout_marginTop="@dimen/size_margin_top_button_main"
                android:layout_marginBottom="@dimen/size_margin_top_button_main"
                android:src="@drawable/ic_sigam_default"
                android:adjustViewBounds="true"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_edittext_jawaban"
                android:textStyle="bold"
                android:textColor="@color/color_black"
                android:gravity="center"
                android:id="@+id/textViewLabelScore"
                android:background="@drawable/bg_rounded_yellow"
                android:padding="@dimen/size_margin_right_top_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  BONUS SCORE  "
                custom:typeface="avengeance"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="70sp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                custom:typeface="dimbo"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
