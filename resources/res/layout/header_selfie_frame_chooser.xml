<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/header_selfie_frame_chooser_0"
    android:padding="8dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.tebakgambar.component.CustomTextView
        android:textSize="@dimen/size_text_top_textview_instruction"
        android:textStyle="bold"
        android:textColor="@color/color_yellow1"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_title_frame"
        custom:typeface="avengeance"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_edittext_hint"
            android:textColor="@color/color_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_subtitle_frame"
            custom:typeface="avengeance"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_edittext_hint"
            android:textColor="@color/color_white"
            android:id="@+id/textViewCaraBermain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_subtitle_2_frame"
            custom:typeface="avengeance"/>
    </LinearLayout>
</LinearLayout>
