<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayoutTop"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_top_bar"
        android:layout_alignParentTop="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/iv_score_start"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="0dp"
                android:src="@drawable/ic_score_container"
                ads:layout_constraintStart_toStartOf="parent"
                ads:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ivScoreEnd"
                android:background="@drawable/item_score_container"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                ads:layout_constraintBottom_toBottomOf="@+id/iv_score_start"
                ads:layout_constraintStart_toEndOf="@+id/iv_score_start"
                ads:layout_constraintTop_toTopOf="@+id/iv_score_start">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_button_green"
                    android:textStyle="bold"
                    android:textColor="@color/official_punya_id_gray"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="40dp"
                    android:maxLines="1"
                    android:layout_weight="2"
                    android:paddingStart="@dimen/size_layout_margin_top_10dp"
                    android:paddingEnd="@dimen/size_layout_margin_top_10dp"
                    ads:innerShadowRadius="2"
                    ads:layout_constraintBottom_toBottomOf="parent"
                    ads:layout_constraintStart_toStartOf="parent"
                    ads:layout_constraintTop_toTopOf="parent"
                    ads:strokeJoinStyle="bevel"
                    ads:typeface="dimbo"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/viewScoreBlink"
                android:background="@color/color_white_30"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                ads:layout_constraintBottom_toBottomOf="@+id/ivScoreEnd"
                ads:layout_constraintEnd_toEndOf="@+id/ivScoreEnd"
                ads:layout_constraintStart_toStartOf="@+id/ivScoreEnd"
                ads:layout_constraintTop_toTopOf="@+id/ivScoreEnd"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/linearLayoutWrapperHeart"
            android:background="@drawable/bg_rounded_green_2"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_right_top_logo"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:id="@+id/textViewScore"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_loading"
                ads:typeface="dimbo"/>
        </LinearLayout>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_logo"
            android:textStyle="bold"
            android:textColor="@color/color_yellow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_margin_right_top_logo"
            android:text="@string/label_tebakgambar"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            ads:innerShadowColor="@color/color_yellow1"
            ads:strokeColor="@color/color_black"
            ads:strokeJoinStyle="bevel"
            ads:typeface="dimbo"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/progressbarBonusTime"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:progress="100"
        android:progressDrawable="@drawable/bg_progressbar"
        android:layout_below="@+id/relativeLayoutTop"
        style="?android:attr/progressBarStyleHorizontal"/>
    <RelativeLayout
        android:id="@+id/relativeLayoutLoading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_top_bar"
        android:layout_centerInParent="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_loading"
            ads:typeface="dimbo"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relativeLayoutFailed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_top_bar"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_edittext_jawaban"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_failed_fetch"
                ads:typeface="dimbo"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:id="@+id/buttonTryAgain"
                android:background="@drawable/selector_button_orange_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_button_margin_top"
                android:text="@string/button_try_again"
                android:maxLines="1"
                ads:innerShadowColor="@color/color_yellow1"
                ads:innerShadowRadius="2"
                ads:strokeJoinStyle="bevel"
                ads:typeface="dimbo"/>
        </LinearLayout>
    </RelativeLayout>
    <com.tebakgambar.component.CustomImageView
        android:id="@+id/imageAds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:id="@+id/linearLayoutWrapperJawaban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frameAds"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/linearLayoutJawaban"
            android:background="@color/color_dark_green_1"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_layout_margin_top"
            android:layout_marginBottom="@dimen/size_admob_height">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_row_text_level_sub"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/textViewInstruksiClue"
                android:padding="@dimen/size_margin_top_textview_instruction_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_instruksi_tg_clue"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomEditText
                android:textSize="@dimen/size_edittext_jawaban"
                android:textColor="@color/color_dark_green_1"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/editTextSoal"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:layout_marginBottom="@dimen/size_padding_button_bottom"
                android:hint="@string/hint_jawab_di_sini"
                android:maxLines="4"
                android:layout_weight="1"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/buttonCek"
                android:background="@drawable/selector_button_orange_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="@dimen/size_button_margin_top"
                android:layout_marginBottom="@dimen/size_button_margin_top"
                android:text="@string/button_cek"
                android:maxLines="1"
                android:layout_weight="2"
                ads:innerShadowColor="@color/color_yellow1"
                ads:innerShadowRadius="2"
                ads:strokeJoinStyle="bevel"
                ads:typeface="dimbo"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollViewWrapperSoal"
        android:paddingTop="5dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:fadingEdge="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_weight="1"
        android:layout_above="@+id/linearLayoutWrapperJawaban"
        android:layout_below="@+id/relativeLayoutTop"
        android:layout_centerHorizontal="true"
        android:fadeScrollbars="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayoutWrapperSoal"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:paddingBottom="@dimen/size_layout_margin_top_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_button_height_number">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/relativeLayoutGlobal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutWrapperBantuan"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_help_question_width"
                    android:layout_marginTop="@dimen/size_padding_button_bottom">
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/relativeLayoutWrapperHint"
                        android:background="@drawable/selector_button_orange_1"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/relativeLayoutQuestionLabel"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true">
                            <ImageView
                                android:gravity="bottom|center_horizontal"
                                android:id="@+id/textViewQuestion2"
                                android:background="@drawable/ic_icon_hint"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/relativeLayoutWrapperTimer"
                        android:background="@drawable/selector_btn_hint"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_margin_top_button_main"
                        android:layout_marginStart="@dimen/size_margin_top_button_main">
                        <RelativeLayout
                            android:id="@+id/relativeLayoutTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true">
                            <com.tebakgambar.component.CustomTextView
                                android:textSize="@dimen/size_hint"
                                android:textColor="@color/color_black"
                                android:gravity="center"
                                android:id="@+id/textViewTimer"
                                android:background="@android:color/transparent"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                ads:typeface="dimbo"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/imageViewShare"
                        android:background="@color/blue_1C5073"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_margin_top_button_main"
                        android:layout_marginRight="0dp">
                        <ImageView
                            android:id="@+id/imageViewShareInstagram"
                            android:background="@drawable/selector_button_transparent"
                            android:padding="@dimen/size_layout_margin_top_10dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_share_hint"
                            ads:layout_constraintBottom_toBottomOf="parent"
                            ads:layout_constraintEnd_toEndOf="parent"
                            ads:layout_constraintStart_toStartOf="parent"
                            ads:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ImageView
                        android:id="@+id/imageViewSkip"
                        android:padding="2dp"
                        android:visibility="gone"
                        android:layout_width="@dimen/size_help_question_width"
                        android:layout_height="@dimen/size_help_question_width"
                        android:layout_marginLeft="@dimen/size_margin_top_button_main"
                        android:src="@drawable/btn_skip"
                        android:layout_marginStart="@dimen/size_margin_top_button_main"/>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/relativeLayoutClueKamu"
                        android:background="@drawable/selector_btn_hint"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/size_margin_top_button_main"
                        android:layout_marginStart="@dimen/size_margin_top_button_main">
                        <com.tebakgambar.component.CustomTextView
                            android:textSize="@dimen/size_hint"
                            android:textColor="@color/color_red_hint"
                            android:gravity="center"
                            android:id="@+id/textViewClueKamu"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_clue_kamu"
                            android:layout_centerInParent="true"
                            ads:typeface="dimbo"/>
                    </RelativeLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/imageViewSoal"
                    android:paddingTop="@dimen/size_layout_margin_top_10dp"
                    android:layout_width="@dimen/size_question_biasa_width"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:layout_below="@+id/linearLayoutWrapperBantuan"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/linearLayoutClue"
                    android:paddingTop="@dimen/size_layout_margin_top_10dp"
                    android:visibility="gone"
                    android:layout_width="@dimen/size_question_biasa_width"
                    android:layout_height="@dimen/size_question_biasa_height"
                    android:layout_below="@+id/linearLayoutWrapperBantuan">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/linearLayoutClue1"
                            android:background="@color/color_black"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/imageClue1"
                                android:layout_width="@dimen/size_admob_height_margin_top"
                                android:layout_height="@dimen/size_admob_height_margin_top"
                                android:src="@drawable/ic_tebakgambar_logo"
                                android:scaleType="centerInside"
                                android:adjustViewBounds="true"/>
                            <com.tebakgambar.component.CustomTextView
                                android:textSize="@dimen/size_row_text_level"
                                android:textStyle="bold"
                                android:textColor="@color/color_black"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/clue_a"
                                ads:typeface="dimbo"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/linearLayoutClue2"
                            android:background="@color/color_red"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/imageClue2"
                                android:layout_width="@dimen/size_admob_height_margin_top"
                                android:layout_height="@dimen/size_admob_height_margin_top"
                                android:src="@drawable/ic_tebakgambar_logo"
                                android:scaleType="centerInside"
                                android:adjustViewBounds="true"/>
                            <com.tebakgambar.component.CustomTextView
                                android:textSize="@dimen/size_row_text_level"
                                android:textStyle="bold"
                                android:textColor="@color/color_black"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/clue_b"
                                ads:typeface="dimbo"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/linearLayoutClue3"
                            android:background="@color/color_gray"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/imageClue3"
                                android:layout_width="@dimen/size_admob_height_margin_top"
                                android:layout_height="@dimen/size_admob_height_margin_top"
                                android:src="@drawable/ic_tebakgambar_logo"
                                android:scaleType="centerInside"
                                android:adjustViewBounds="true"/>
                            <com.tebakgambar.component.CustomTextView
                                android:textSize="@dimen/size_row_text_level"
                                android:textStyle="bold"
                                android:textColor="@color/color_black"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/clue_c"
                                ads:typeface="dimbo"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/linearLayoutClue4"
                            android:background="@color/color_pink"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/imageClue4"
                                android:layout_width="@dimen/size_admob_height_margin_top"
                                android:layout_height="@dimen/size_admob_height_margin_top"
                                android:src="@drawable/ic_tebakgambar_logo"
                                android:scaleType="centerInside"
                                android:adjustViewBounds="true"/>
                            <com.tebakgambar.component.CustomTextView
                                android:textSize="@dimen/size_row_text_level"
                                android:textStyle="bold"
                                android:textColor="@color/color_black"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/clue_d"
                                ads:typeface="dimbo"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/relativeLayoutFrom"
                    android:background="@color/color_gray"
                    android:paddingLeft="@dimen/size_margin_top_button_main"
                    android:paddingTop="1dp"
                    android:paddingRight="@dimen/size_margin_top_button_main"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    android:layout_width="@dimen/size_question_biasa_width"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imageViewSoal">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_text_button"
                        android:textColor="@color/color_dark_gray"
                        android:gravity="center"
                        android:id="@+id/textViewFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_text_button"
                        android:textColor="@color/color_dark_gray"
                        android:gravity="center"
                        android:id="@+id/textViewFromUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
    <com.tebakgambar.component.ClickableImageView
        android:id="@+id/imageViewFreeAnswer"
        android:visibility="gone"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="@dimen/size_margin_top_button_main"
        android:layout_marginRight="@dimen/size_margin_top_bottom_button"
        android:layout_marginBottom="64dp"
        android:layout_above="@+id/linearLayoutWrapperJawaban"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/size_margin_top_bottom_button"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
