<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayoutRow"
    android:tag="layout/row_item_level_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/relativeLayoutWrapperLevel"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_row_margin_left_right"
        android:layout_marginTop="@dimen/size_row_margin_top"
        android:layout_marginRight="@dimen/size_row_margin_left_right">
        <RelativeLayout
            android:id="@+id/relativeLayoutUnlockedEvent"
            android:background="@drawable/selector_button_transparent"
            android:paddingLeft="@dimen/size_row_padding_right"
            android:paddingRight="@dimen/size_row_padding_right"
            android:paddingBottom="@dimen/size_row_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_row_text_level_event"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/textViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                custom:typeface="dimbo"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction"
                android:textColor="@color/color_white"
                android:gravity="top|center_horizontal"
                android:id="@+id/textViewSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewTitle"
                custom:typeface="avengeance"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relativeLayoutWrapperUnlocked"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_row_margin_left_right"
        android:layout_marginTop="@dimen/size_row_margin_top"
        android:layout_marginRight="@dimen/size_row_margin_left_right">
        <RelativeLayout
            android:id="@+id/relativeLayoutUnlocked"
            android:background="@drawable/selector_button_transparent"
            android:paddingLeft="@dimen/size_row_padding_left"
            android:paddingRight="@dimen/size_row_padding_right"
            android:paddingBottom="@dimen/size_row_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/linearLayoutLevelSpecial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_row_padding_top"
                android:layout_centerVertical="true">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_row_text_level_special"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/textViewLevelSpecial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    custom:typeface="dimbo"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_row_text_level_sub"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:id="@+id/textViewLevelSpecialSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_row_text_level_special_margin_top"
                    custom:typeface="dimbo"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/imageViewLevelIcon"
                android:layout_width="@dimen/size_row_unlock_width"
                android:layout_height="@dimen/size_row_unlock_height"
                android:layout_marginTop="@dimen/size_row_padding_top"
                android:layout_marginRight="@dimen/size_layout_margin_bottom"
                android:src="@drawable/ic_sigam_level_1"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_row_text_level"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:id="@+id/textViewLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_row_padding_top"
                android:layout_centerVertical="true"
                custom:typeface="dimbo"/>
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imageViewRibbon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_layout_margin_bottom"
        android:layout_marginRight="@dimen/size_padding_button_right"
        android:src="@drawable/ic_ribbon"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/relativeLayoutWrapperLocked"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_row_margin_left_right"
        android:layout_marginTop="@dimen/size_row_margin_top"
        android:layout_marginRight="@dimen/size_row_margin_left_right">
        <RelativeLayout
            android:id="@+id/relativeLayoutLocked"
            android:background="@drawable/selector_button_transparent"
            android:paddingLeft="@dimen/size_row_padding_left"
            android:paddingRight="@dimen/size_row_padding_right"
            android:paddingBottom="@dimen/size_row_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/size_row_lock_width"
                android:layout_height="@dimen/size_row_lock_height"
                android:layout_margin="@dimen/size_button_margin_top"
                android:src="@drawable/ic_gembok"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
