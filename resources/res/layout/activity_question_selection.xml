<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_question_selection_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:id="@+id/headerFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        class="com.tebakgambar.component.TGHeaderFragment"/>
    <RelativeLayout
        android:id="@+id/relativeLayoutInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/headerFragment">
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_yellow1"
            android:gravity="center"
            android:id="@+id/buttonLevel"
            android:tag="binding_1"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_button_level_margin_left"
            android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
            android:layout_marginRight="@dimen/size_button_level_margin_right"
            android:text="@string/button_level"
            android:layout_centerVertical="true"
            ads:innerShadowColor="@color/color_yellow1"
            ads:innerShadowRadius="2"
            ads:strokeJoinStyle="bevel"
            ads:typeface="dimbo"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_level_pilih_soal"
            android:textColor="@color/color_white"
            android:id="@+id/textViewLevelIndicator"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_textview_level_margin_left"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            ads:typeface="avengeance"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/size_gridview_margin_left"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:layout_above="@+id/frameAds"
        android:layout_below="@+id/relativeLayoutInfo"/>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
