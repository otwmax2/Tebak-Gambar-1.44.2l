<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tebakgambar.component.CustomTextView
        android:textSize="@dimen/size_text_instruction"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:gravity="center_vertical"
        android:id="@+id/textViewRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_padding_button_bottom"
        android:drawableLeft="@drawable/ic_bullets_circle"
        android:drawablePadding="@dimen/size_padding_button_bottom"
        custom:typeface="avengeance"/>
</LinearLayout>
