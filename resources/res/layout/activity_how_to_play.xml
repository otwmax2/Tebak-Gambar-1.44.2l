<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_how_to_play_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/header_normal"/>
    <ScrollView
        android:id="@+id/scrollViewWrapperInstruction"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/frameAds"
        android:layout_below="@+id/relativeLayoutTop"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingTop="10dp"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_top_textview_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:id="@+id/textViewTitleCaraMenebakGambar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                    android:text="@string/label_cara_menebak_gambar"
                    custom:typeface="avengeance"/>
                <androidx.legacy.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_white"
                    android:id="@+id/textViewAppVersion"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                    android:layout_marginRight="4dp"
                    android:text="@string/app_version_code"
                    custom:typeface="avengeance"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_green"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_1"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_2"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_3"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_4"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_5"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomImageView
                    android:id="@+id/imageViewContoh"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_triangle_dialog_height"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:src="@drawable/ic_contoh_green"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_6"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_cara_menebak_gambar_7"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
            </LinearLayout>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_top_textview_instruction"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:id="@+id/textViewLabelAturanPermainan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_margin_top_textview_instruction_top"
                android:text="@string/label_aturan_permainan"
                custom:typeface="avengeance"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_green"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_permainan_1"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_permainan_2"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_permainan_3"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_permainan_4"
                    android:drawableLeft="@drawable/ic_bullets_circle"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
            </LinearLayout>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_top_textview_instruction"
                android:textStyle="bold"
                android:textColor="@color/color_yellow1"
                android:id="@+id/textViewLabelAturanKuisSelfie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_margin_top_textview_instruction_top"
                android:text="@string/label_aturan_kuis_selfie"
                custom:typeface="avengeance"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_green"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:layout_marginBottom="@dimen/size_padding_wrapper_content">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_yellow1"
                    android:gravity="top"
                    android:id="@+id/textViewAturanSelfie_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_kuis_selfie_1_1"
                    android:drawableLeft="@drawable/ic_bullets_yellow"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
