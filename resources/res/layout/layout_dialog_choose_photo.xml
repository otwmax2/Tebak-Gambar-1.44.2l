<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background_inset"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_textview_credit_textsize"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/buttonLeaderboard"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_dari_kamera"
            android:maxLines="1"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_textview_credit_textsize"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/buttonFoto"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_button_margin_top"
            android:text="@string/button_dari_kamera"
            android:maxLines="1"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_textview_credit_textsize"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/buttonGaleri"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_button_margin_top"
            android:text="@string/button_dari_galeri"
            android:maxLines="1"
            custom:typeface="dimbo"/>
    </LinearLayout>
</RelativeLayout>
