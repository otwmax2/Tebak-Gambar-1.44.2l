<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_dialog_share_0"
    android:paddingBottom="@dimen/size_row_padding_20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:background="@drawable/dialog_background_inset"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_level_pilih_soal"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewQuestion"
            android:padding="@dimen/size_row_padding_20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_dialog_title_2"
            custom:layout_constraintEnd_toEndOf="parent"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toTopOf="parent"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_instruction_kirim_saran"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewButton1"
            android:background="@drawable/selector_bg_violet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:text="Instagram"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_layout_margin_top_10dp"
            android:layout_marginEnd="@dimen/size_layout_margin_top_10dp"
            custom:layout_constraintEnd_toEndOf="parent"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toBottomOf="@+id/textViewQuestion"
            custom:typeface="dimbo"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="0dp"
            custom:layout_constraintBottom_toBottomOf="@+id/textViewButton1"
            custom:layout_constraintStart_toStartOf="@+id/textViewButton1"
            custom:layout_constraintTop_toTopOf="@+id/textViewButton1"
            custom:srcCompat="@drawable/ic_share_ig_hint"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_instruction_kirim_saran"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewButton2"
            android:background="@drawable/selector_bg_blue_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:text="Twitter"
            android:maxLines="1"
            android:layout_marginStart="@dimen/size_layout_margin_top_10dp"
            android:layout_marginEnd="@dimen/size_layout_margin_top_10dp"
            custom:layout_constraintEnd_toEndOf="parent"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toBottomOf="@+id/textViewButton1"
            custom:typeface="dimbo"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="0dp"
            custom:layout_constraintBottom_toBottomOf="@+id/textViewButton2"
            custom:layout_constraintStart_toStartOf="@+id/textViewButton2"
            custom:layout_constraintTop_toTopOf="@+id/textViewButton2"
            custom:srcCompat="@drawable/ic_share_twitter_hint"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="0dp"
            custom:layout_constraintBottom_toBottomOf="@+id/textViewButton3"
            custom:layout_constraintStart_toStartOf="@+id/textViewButton3"
            custom:layout_constraintTop_toTopOf="@+id/textViewButton3"
            custom:srcCompat="@drawable/ic_general_share_other"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_instruction_kirim_saran"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewButton3"
            android:background="@drawable/selector_bg_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:text="@string/share_other"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_layout_margin_top_10dp"
            android:layout_marginEnd="@dimen/size_layout_margin_top_10dp"
            custom:layout_constraintEnd_toEndOf="parent"
            custom:layout_constraintStart_toStartOf="parent"
            custom:layout_constraintTop_toBottomOf="@+id/textViewButton2"
            custom:typeface="dimbo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/imageViewClose"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="@dimen/size_row_padding_20dp"
        android:src="@drawable/ic_dialog_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
