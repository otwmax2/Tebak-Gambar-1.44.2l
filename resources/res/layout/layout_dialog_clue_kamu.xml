<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayoutWrapperContent"
        android:background="@drawable/bg_dialog_bantuan"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingTop="@dimen/size_layout_padding_top"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:layout_width="@dimen/size_layout_yellow_dialog_height"
        android:layout_height="wrap_content">
        <ScrollView
            android:id="@+id/scrollView1"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_dialog_title"
                    android:textStyle="bold"
                    android:textColor="@color/color_black"
                    android:gravity="center_horizontal"
                    android:id="@+id/textViewLabelBantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_clue_kamu"
                    custom:typeface="dimbo"/>
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutClue1"
                    android:background="@drawable/selector_button_red_1"
                    android:visibility="visible"
                    android:layout_width="@dimen/size_button_margin_left"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_top_bottom_button"
                    android:layout_marginTop="@dimen/size_margin_top_button_main"
                    android:layout_marginRight="@dimen/size_margin_top_bottom_button"
                    android:minWidth="@dimen/size_layout_height">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_hint"
                        android:textColor="@color/color_white"
                        android:gravity="center"
                        android:id="@+id/textViewClue1"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jawab_clue_a"
                        android:layout_centerInParent="true"
                        custom:typeface="dimbo"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutClue2"
                    android:background="@drawable/selector_button_red_1"
                    android:visibility="visible"
                    android:layout_width="@dimen/size_button_margin_left"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_top_bottom_button"
                    android:layout_marginTop="@dimen/size_margin_top_button_main"
                    android:layout_marginRight="@dimen/size_margin_top_bottom_button"
                    android:minWidth="@dimen/size_layout_height">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_hint"
                        android:textColor="@color/color_white"
                        android:gravity="center"
                        android:id="@+id/textViewClue2"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jawab_clue_b"
                        android:layout_centerInParent="true"
                        custom:typeface="dimbo"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutClue3"
                    android:background="@drawable/selector_button_red_1"
                    android:visibility="visible"
                    android:layout_width="@dimen/size_button_margin_left"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_top_bottom_button"
                    android:layout_marginTop="@dimen/size_margin_top_button_main"
                    android:layout_marginRight="@dimen/size_margin_top_bottom_button"
                    android:minWidth="@dimen/size_layout_height">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_hint"
                        android:textColor="@color/color_white"
                        android:gravity="center"
                        android:id="@+id/textViewClue3"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jawab_clue_c"
                        android:layout_centerInParent="true"
                        custom:typeface="dimbo"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayoutClue4"
                    android:background="@drawable/selector_button_red_1"
                    android:visibility="visible"
                    android:layout_width="@dimen/size_button_margin_left"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_top_bottom_button"
                    android:layout_marginTop="@dimen/size_margin_top_button_main"
                    android:layout_marginRight="@dimen/size_margin_top_bottom_button"
                    android:minWidth="@dimen/size_layout_height">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_hint"
                        android:textColor="@color/color_white"
                        android:gravity="center"
                        android:id="@+id/textViewClue4"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jawab_clue_d"
                        android:layout_centerInParent="true"
                        custom:typeface="dimbo"/>
                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:id="@+id/textViewDecline"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:minWidth="@dimen/size_layout_height"
            android:text="@string/label_keluar"
            android:maxLines="1"
            android:layout_below="@+id/scrollView1"
            android:layout_centerHorizontal="true"
            custom:typeface="dimbo"/>
    </RelativeLayout>
</RelativeLayout>
