<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background_inset"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:overScrollMode="never">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/relativeLayoutWrapperContent"
            android:paddingLeft="@dimen/size_layout_padding_left"
            android:paddingRight="@dimen/size_layout_padding_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_top_textview_instruction"
                android:textStyle="bold"
                android:textColor="@color/color_black"
                android:id="@+id/textViewLabelAturanKuisSelfie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/label_aturan_kuis_selfie"
                custom:typeface="avengeance"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearWrapperInstruction"
                android:padding="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:layout_below="@+id/textViewLabelAturanKuisSelfie">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_black"
                    android:gravity="center_vertical"
                    android:id="@+id/textViewAturanSelfie_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:text="@string/label_tutorial_aturan_kuis_selfie_1_1"
                    android:drawableLeft="@drawable/ic_bullets_black"
                    android:drawablePadding="@dimen/size_padding_button_bottom"
                    custom:typeface="avengeance"/>
            </LinearLayout>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonClose"
                android:background="@drawable/selector_button_green_1"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:paddingTop="@dimen/size_text_timer_margin_bottom"
                android:paddingRight="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_text_timer_margin_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_decline_2"
                android:maxLines="1"
                android:layout_below="@+id/linearWrapperInstruction"
                android:layout_centerHorizontal="true"
                custom:typeface="dimbo"/>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
