<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayoutMain"
    android:tag="layout/activity_edit_frame_0"
    android:background="@color/color_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_normal"/>
    <ScrollView
        android:paddingLeft="10dp"
        android:paddingTop="20dp"
        android:paddingRight="10dp"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frameAds"
        android:layout_below="@+id/relativeLayoutTop"
        android:overScrollMode="never">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/relativeLayoutWrapperFrames"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/relativeLayoutButtonEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_button_margin_top">
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textColor="@color/color_yellow1"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/buttonMainLagi"
                    android:background="@drawable/selector_button_green_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:text="@string/button_main_lagi"
                    android:maxLines="1"
                    android:layout_alignParentLeft="true"
                    ads:typeface="dimbo"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textColor="@color/color_yellow1"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/buttonAturan"
                    android:background="@drawable/selector_button_green_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:text="@string/button_baca_aturan"
                    android:maxLines="1"
                    android:layout_alignParentRight="true"
                    ads:typeface="dimbo"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/relativeLayoutFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_layout_margin_top"
                android:layout_below="@+id/relativeLayoutButtonEvent">
                <View
                    android:id="@+id/center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/imageViewFrameImageOrang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/orang"
                    android:scaleType="fitXY"
                    android:layout_alignLeft="@+id/frameView"
                    android:layout_alignTop="@+id/frameView"
                    android:layout_alignRight="@+id/center"
                    android:layout_alignBottom="@+id/frameView"/>
                <com.framer.FrameView
                    android:id="@+id/frameView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <View
                    android:id="@+id/viewTransparentOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <RelativeLayout
                    android:id="@+id/relativeLayoutSticker"
                    android:background="@color/color_white"
                    android:padding="@dimen/size_margin_top_textview_instruction_top"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_edittext_jawaban"
                        android:textColor="@color/color_black_sticker"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_sticker"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        ads:typeface="dimbo"/>
                    <ImageView
                        android:id="@+id/imageViewStickerSiGam"
                        android:layout_width="@dimen/size_question_raja_height"
                        android:layout_height="@dimen/size_question_raja_height"
                        android:layout_marginBottom="@dimen/size_layout_padding_right"
                        android:src="@drawable/frame_default"
                        android:scaleType="fitXY"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/relativeLayoutFailed"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_question_biasa_height"
                    android:layout_marginTop="@dimen/size_top_bar"
                    android:layout_centerInParent="true">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">
                        <com.tebakgambar.component.CustomTextView
                            android:textSize="@dimen/size_edittext_jawaban"
                            android:textColor="@color/color_white"
                            android:gravity="center_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_failed_fetch"
                            ads:typeface="dimbo"/>
                        <com.tebakgambar.component.CustomButton
                            android:textSize="@dimen/size_text_button_green"
                            android:textStyle="bold"
                            android:textColor="@color/color_white"
                            android:gravity="center_horizontal"
                            android:id="@+id/buttonTryAgain"
                            android:background="@drawable/selector_button_orange_1"
                            android:paddingTop="@dimen/size_padding_button_bottom"
                            android:paddingBottom="@dimen/size_padding_button_bottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_button_margin_top"
                            android:text="@string/button_try_again"
                            android:maxLines="1"
                            ads:innerShadowColor="@color/color_yellow1"
                            ads:innerShadowRadius="2"
                            ads:strokeJoinStyle="bevel"
                            ads:typeface="dimbo"/>
                    </LinearLayout>
                </RelativeLayout>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/textViewLoading"
                    android:background="@color/color_main"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_question_biasa_height"
                    android:text="@string/label_loading"
                    android:layout_centerInParent="true"
                    ads:typeface="dimbo"/>
            </RelativeLayout>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textColor="@color/color_yellow1"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/buttonTutorial"
                android:background="@drawable/selector_button_green_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_button_margin_top"
                android:text="@string/button_tutorial"
                android:maxLines="1"
                android:layout_below="@+id/relativeLayoutFrame"
                ads:typeface="dimbo"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/buttonTutorial">
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/buttonGantiGambar"
                    android:background="@drawable/selector_button_green_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:text="@string/button_ganti_foto"
                    android:maxLines="1"
                    android:layout_weight="1"
                    ads:typeface="dimbo"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/buttonSimpan"
                    android:background="@drawable/selector_button_green_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:layout_marginRight="5dp"
                    android:text="@string/button_simpan"
                    android:maxLines="1"
                    android:layout_weight="1"
                    ads:typeface="dimbo"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/buttonShare"
                    android:background="@drawable/selector_button_green_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:text="@string/button_bagikan"
                    android:maxLines="1"
                    android:layout_weight="1"
                    ads:typeface="dimbo"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
