<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="50dp">
    <FrameLayout
        android:id="@+id/relativeLayoutOfflineAds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.tebakgambar.component.CustomImageView
            android:id="@+id/imageAds1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_admob_height"/>
        <com.tebakgambar.component.CustomImageView
            android:id="@+id/imageAds2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_admob_height"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/adViewContainer"
        android:background="@color/color_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/unifiedAdView"
            android:background="@drawable/native_ad_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_admob_height">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_white"
                android:background="#fbb320"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_sigam_ad"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_black"
                    android:gravity="center_horizontal"
                    android:id="@+id/textViewUnifiedAdTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="14sp"
                    android:textColor="@color/color_dark_green_1"
                    android:id="@+id/buttonUnifiedAdAction"
                    android:background="@drawable/bg_rounded_yellow"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.gms.ads.nativead.NativeAdView>
    </FrameLayout>
    <com.tebakgambar.component.CustomImageView
        android:id="@+id/imageAdsScreenshot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_admob_height"
        android:src="@drawable/ads_5juta"
        android:scaleType="centerInside"/>
    <com.tebakgambar.component.CustomImageView
        android:id="@+id/imageAlternativeAd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_admob_height"
        android:src="@drawable/ads_5juta"
        android:scaleType="centerInside"/>
</FrameLayout>
