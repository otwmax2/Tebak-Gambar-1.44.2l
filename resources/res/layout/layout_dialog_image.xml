<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background_inset"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/linearLayoutWrapperImage"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">
        <RelativeLayout
            android:id="@+id/relativeLayoutImageViewFacebook"
            android:layout_width="@dimen/size_imageview_height"
            android:layout_height="@dimen/size_imageview_height"
            android:layout_marginRight="3dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imageViewFacebook"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_imageview_height"
                android:src="@drawable/ic_share_fb"/>
            <ProgressBar
                android:id="@+id/progressBarFacebook"
                android:visibility="gone"
                android:layout_width="@dimen/size_help_question_height"
                android:layout_height="@dimen/size_help_question_height"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relativeLayoutImageViewTwitter"
            android:layout_width="@dimen/size_imageview_height"
            android:layout_height="@dimen/size_imageview_height"
            android:layout_marginLeft="3dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imageViewTwitter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_imageview_height"
                android:src="@drawable/ic_share_twitter"/>
            <ProgressBar
                android:id="@+id/progressBarTwitter"
                android:visibility="gone"
                android:layout_width="@dimen/size_help_question_height"
                android:layout_height="@dimen/size_help_question_height"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relativeLayoutImageViewInstagram"
            android:layout_width="@dimen/size_imageview_height"
            android:layout_height="@dimen/size_imageview_height"
            android:layout_marginLeft="3dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imageViewInstagram"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_imageview_height"
                android:src="@drawable/ig_share"/>
            <ProgressBar
                android:id="@+id/progressBarInstagram"
                android:visibility="gone"
                android:layout_width="@dimen/size_help_question_height"
                android:layout_height="@dimen/size_help_question_height"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/linearLayoutWrapperStatus"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_width_button"
        android:layout_marginTop="3dp">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_instruction_kirim_saran"
            android:textStyle="bold"
            android:textColor="@color/color_dark_green_1"
            android:id="@+id/textViewLabelPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
            android:text="Tweet this post"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            custom:typeface="avengeance"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_instruction_kirim_saran"
            android:textStyle="bold"
            android:textColor="@color/color_dark_green_low"
            android:id="@+id/textViewLimitPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
            android:text="0"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            custom:typeface="avengeance"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_yellow2"
            android:gravity="center"
            android:id="@+id/buttonHashTag"
            android:background="@drawable/selector_button_green_1"
            android:paddingLeft="@dimen/size_padding_button_bottom"
            android:paddingTop="@dimen/size_text_timer_margin_bottom"
            android:paddingRight="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_text_timer_margin_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_padding_button_bottom"
            android:text="@string/button_kuis"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            custom:typeface="dimbo"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/linearLayoutButtonPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonCancel"
                android:background="@drawable/selector_button_green_1"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:paddingTop="@dimen/size_text_timer_margin_bottom"
                android:paddingRight="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_text_timer_margin_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_padding_button_bottom"
                android:text="@string/button_cancel"
                custom:typeface="dimbo"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/linearLayoutButtonShare"
                android:background="@drawable/selector_button_green_1"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:paddingTop="@dimen/size_text_timer_margin_bottom"
                android:paddingRight="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_text_timer_margin_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/progressBarShare"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/size_text_timer_margin_bottom"
                    style="?android:attr/progressBarStyleSmallInverse"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textStyle="bold"
                    android:textColor="@color/color_yellow1"
                    android:id="@+id/buttonShare"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_share"
                    custom:typeface="dimbo"/>
            </LinearLayout>
        </LinearLayout>
        <com.tebakgambar.component.CustomEditText
            android:textSize="@dimen/size_text_edittext_hint"
            android:textColor="@color/color_dark_green_1"
            android:gravity="top|left"
            android:orientation="vertical"
            android:id="@+id/editTextPost"
            android:background="@drawable/bg_rounded_white"
            android:padding="@dimen/size_padding_wrapper_content_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_padding_button_bottom"
            android:minHeight="@dimen/size_height_minimum"
            android:singleLine="false"
            android:layout_above="@+id/linearLayoutButtonPost"
            android:layout_below="@+id/textViewLabelPost"
            custom:typeface="dimbo"/>
    </RelativeLayout>
</RelativeLayout>
