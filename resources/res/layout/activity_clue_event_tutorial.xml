<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_clue_event_tutorial_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/header_normal"/>
    <ScrollView
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/frameAds"
        android:layout_below="@+id/relativeLayoutTop"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingTop="10dp"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_top_textview_instruction"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:id="@+id/textViewTitleCaraMenebakGambar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                android:text="@string/label_tips_tg_clue"
                ads:typeface="avengeance"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_green"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom">
                <com.tebakgambar.component.CustomListView
                    android:id="@+id/listView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@android:color/transparent"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="@android:color/transparent"/>
            </LinearLayout>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button"
                android:textColor="@color/color_white"
                android:id="@+id/buttonMain"
                android:tag="binding_1"
                android:background="@drawable/selector_button_orange_1"
                android:paddingTop="@dimen/size_padding_top_button_main"
                android:paddingBottom="@dimen/size_padding_bottom_button_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                android:text="@string/label_ayo_main_tg_clue"
                ads:typeface="avengeance"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
