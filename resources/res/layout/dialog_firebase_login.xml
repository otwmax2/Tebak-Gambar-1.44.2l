<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_firebase_login_0"
    android:background="@drawable/dialog_background_inset"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayoutWrapperContent"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_level_pilih_soal"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewQuestion"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            custom:typeface="dimbo"/>
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewQuestion">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/linearLayoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/textViewGoogle"
                    android:tag="binding_2"
                    android:background="@drawable/button_firebase_google"
                    android:paddingLeft="4dp"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/size_row_padding_right"
                    android:text="@string/login_with_google"
                    android:maxLines="1"
                    android:drawableLeft="@drawable/ic_logo_google"
                    android:layout_weight="1"
                    custom:typeface="dimbo"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/textViewFacebook"
                    android:tag="binding_3"
                    android:background="@drawable/button_firebase_facebook"
                    android:paddingLeft="4dp"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/size_row_padding_right"
                    android:text="@string/login_with_facebook"
                    android:maxLines="1"
                    android:drawableLeft="@drawable/ic_logo_facebook"
                    android:layout_weight="1"
                    custom:typeface="dimbo"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/color_black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/textViewPrivacyPolicy"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_left_right_global"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="@dimen/size_margin_left_right_global"
                    android:layout_marginBottom="8dp"
                    android:text="@string/kebijakan_privasi"
                    custom:typeface="captamerica"/>
            </LinearLayout>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_level_pilih_soal"
                android:textStyle="bold"
                android:textColor="@color/color_black"
                android:gravity="center"
                android:id="@+id/textViewLoading"
                android:background="@color/color_yellow3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/loading"
                custom:typeface="dimbo"/>
        </FrameLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imageViewClose"
        android:tag="binding_5"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="-20dp"
        android:layout_marginRight="-20dp"
        android:src="@drawable/ic_dialog_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
