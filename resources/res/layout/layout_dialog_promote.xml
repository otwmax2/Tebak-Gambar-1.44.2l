<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_promo_background_inset"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tebakgambar.component.CustomImageView
        android:id="@+id/imageViewPromote"
        android:layout_width="@dimen/size_question_biasa_height"
        android:layout_height="@dimen/size_question_biasa_height"
        android:layout_marginTop="3dp"
        android:src="@drawable/ads_exit"
        android:scaleType="centerInside"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_below="@+id/imageViewPromote">
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewDecline"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:layout_marginRight="3dp"
            android:text="@string/label_keluar"
            android:maxLines="1"
            android:layout_weight="1"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_yellow1"
            android:gravity="center"
            android:id="@+id/textViewAccept"
            android:background="@drawable/selector_button_green_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:text="@string/resume_game"
            android:maxLines="1"
            android:layout_weight="1"
            custom:typeface="dimbo"/>
    </LinearLayout>
</RelativeLayout>
