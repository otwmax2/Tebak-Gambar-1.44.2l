<?xml version="1.0" encoding="utf-8"?>
<com.tebakgambar.component.LoadingView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tebakgambar.component.CustomTextView
        android:textSize="@dimen/size_text_button_green"
        android:textColor="@color/color_black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/progressBarLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_margin_left_right_global"
        android:layout_marginTop="@dimen/size_margin_top_bottom_button"
        android:layout_marginRight="@dimen/size_margin_left_right_global"
        android:layout_marginBottom="5dp"
        android:text="@string/label_loading"
        custom:typeface="captamerica"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_edittext_jawaban"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewErrorMessage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_failed_fetch"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center_horizontal"
            android:id="@+id/buttonRetry"
            android:background="@drawable/selector_button_orange_1"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_button_margin_top"
            android:text="@string/button_try_again"
            android:maxLines="1"
            custom:innerShadowColor="@color/color_yellow1"
            custom:innerShadowRadius="2"
            custom:strokeJoinStyle="bevel"
            custom:typeface="dimbo"/>
    </LinearLayout>
</com.tebakgambar.component.LoadingView>
