<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/row_item_frame_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/linearLayoutWrapperFrameItem"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/relativeLayoutWrapperFrame"
            android:background="@color/color_dark_green_1"
            android:layout_width="@dimen/size_layout_yellow_dialog_height"
            android:layout_height="@dimen/size_layout_yellow_dialog_height">
            <ImageView
                android:id="@+id/imageViewFrameImageOrang"
                android:layout_width="@dimen/size_layout_yellow_dialog_height_half"
                android:layout_height="@dimen/size_layout_yellow_dialog_height"
                android:src="@drawable/orang"
                android:scaleType="fitXY"
                android:layout_alignLeft="@+id/imageViewFrameImage"/>
            <ImageView
                android:id="@+id/imageViewFrameImage"
                android:layout_width="@dimen/size_layout_yellow_dialog_height"
                android:layout_height="@dimen/size_layout_yellow_dialog_height"
                android:src="@drawable/ic_frame_locked"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/textViewLoading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_loading"
                android:layout_centerInParent="true"
                custom:typeface="dimbo"/>
        </RelativeLayout>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_button"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewLabelFrame"
            android:background="@color/color_black_frame"
            android:paddingLeft="5dp"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingRight="5dp"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="@dimen/size_layout_yellow_dialog_height"
            android:layout_height="wrap_content"
            android:text="@string/label_frame_item"
            custom:typeface="dimbo"/>
    </LinearLayout>
</LinearLayout>
