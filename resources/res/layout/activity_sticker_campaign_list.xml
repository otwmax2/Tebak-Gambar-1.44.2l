<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_sticker_campaign_list_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_normal"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.tebakgambar.component.CustomTextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/textViewTitle"
                android:tag="binding_1"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:typeface="avengeance"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/relativeLayoutLoading"
            android:tag="binding_2"
            android:background="@color/color_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_loading"
                android:layout_centerInParent="true"
                app:typeface="dimbo"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relativeLayoutFailed"
            android:tag="binding_3"
            android:background="@color/color_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/size_top_bar">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_edittext_jawaban"
                    android:textColor="@color/color_white"
                    android:gravity="center_horizontal"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typeface="dimbo"/>
                <com.tebakgambar.component.CustomButton
                    android:textSize="@dimen/size_text_button_green"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/buttonTryAgain"
                    android:tag="binding_5"
                    android:background="@drawable/selector_button_orange_1"
                    android:paddingTop="@dimen/size_padding_button_bottom"
                    android:paddingBottom="@dimen/size_padding_button_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_button_margin_top"
                    android:text="@string/button_try_again"
                    android:maxLines="1"
                    app:innerShadowColor="@color/color_yellow1"
                    app:innerShadowRadius="2"
                    app:strokeJoinStyle="bevel"
                    app:typeface="dimbo"/>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
