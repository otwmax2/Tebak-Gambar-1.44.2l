<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayoutMain"
    android:background="@color/color_main"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayoutTop"
        android:background="@color/color_dark_green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_top_bar"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toTopOf="parent">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_logo"
            android:textStyle="bold"
            android:textColor="@color/color_yellow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/size_margin_right_top_logo"
            android:text="@string/label_tebakgambar"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            ads:innerShadowColor="@color/color_yellow1"
            ads:strokeColor="@color/color_black"
            ads:strokeJoinStyle="bevel"
            ads:typeface="dimbo"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_below="@+id/relativeLayoutTop"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/relativeLayoutTop">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/linearLayoutMain"
            android:paddingLeft="@dimen/size_padding_wrapper_content_quotes"
            android:paddingTop="20dp"
            android:paddingRight="@dimen/size_padding_wrapper_content_quotes"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/buttonMainLagi"
                android:background="@drawable/selector_button_green_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_button_margin_top"
                android:text="@string/button_main_lagi"
                android:maxLines="1"
                ads:layout_constraintEnd_toEndOf="parent"
                ads:layout_constraintTop_toTopOf="parent"
                ads:typeface="dimbo"/>
            <com.tebakgambar.component.CustomButton
                android:enabled="false"
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_yellow1"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/buttonCongrats"
                android:background="@drawable/selector_button_green_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                android:text="@string/label_quotes_congrats"
                ads:innerShadowColor="@color/color_yellow1"
                ads:innerShadowRadius="2"
                ads:layout_constraintStart_toStartOf="parent"
                ads:layout_constraintTop_toBottomOf="@+id/buttonMainLagi"
                ads:strokeJoinStyle="bevel"
                ads:typeface="dimbo"/>
            <RelativeLayout
                android:id="@+id/finishContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                ads:layout_constraintStart_toStartOf="parent"
                ads:layout_constraintTop_toBottomOf="@+id/buttonCongrats">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/linearLayoutQuotes"
                    android:background="@drawable/bg_quotes"
                    android:paddingLeft="@dimen/size_layout_yellow_dialog_padding_left"
                    android:paddingTop="@dimen/size_layout_yellow_quotes_dialog_padding_top"
                    android:paddingRight="@dimen/size_layout_yellow_dialog_padding_right"
                    android:paddingBottom="@dimen/size_layout_yellow_quotes_dialog_padding_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_textview_quotes"
                        android:textStyle="bold"
                        android:textColor="@color/color_black"
                        android:gravity="center"
                        android:id="@+id/textViewQuotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                    <RelativeLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.tebakgambar.component.CustomTextView
                            android:textSize="@dimen/size_textview_quotes"
                            android:textStyle="bold"
                            android:textColor="@color/color_yellow1"
                            android:gravity="center"
                            android:id="@+id/textViewNotifSelfie1"
                            android:background="@drawable/bg_rounded_red"
                            android:paddingLeft="5dp"
                            android:paddingTop="3dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="3dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/label_quotes_notif_selfie"
                            ads:typeface="dimbo"/>
                        <com.tebakgambar.component.CustomTextView
                            android:textSize="@dimen/size_textview_quotes"
                            android:textStyle="bold"
                            android:textColor="@color/color_white"
                            android:gravity="center"
                            android:id="@+id/textViewNotifSelfie"
                            android:background="@drawable/bg_rounded_red"
                            android:paddingLeft="5dp"
                            android:paddingTop="3dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="3dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/label_quotes_notif_selfie"
                            ads:typeface="dimbo"/>
                    </RelativeLayout>
                </LinearLayout>
                <ImageView
                    android:id="@+id/imageViewTriangleDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_triangle_dialog_height"
                    android:layout_marginLeft="@dimen/size_layout_margin_left"
                    android:layout_marginTop="@dimen/size_triangle_dialog_margin_height"
                    android:src="@drawable/triangle_dialog_box"
                    android:scaleType="fitXY"
                    android:layout_below="@+id/linearLayoutQuotes"/>
                <ImageView
                    android:id="@+id/imageViewSiGam"
                    android:layout_width="@dimen/size_sigam_story"
                    android:layout_height="@dimen/size_sigam_story"
                    android:layout_marginLeft="@dimen/size_sigam_story_margin_left"
                    android:layout_marginTop="@dimen/size_sigam_story_margin_top"
                    android:src="@drawable/ic_sigam_quotes"
                    android:layout_toRightOf="@+id/imageViewTriangleDialog"
                    android:layout_below="@+id/imageViewTriangleDialog"/>
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scoreContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ads:layout_constraintEnd_toEndOf="parent"
                ads:layout_constraintStart_toStartOf="parent"
                ads:layout_constraintTop_toBottomOf="@+id/finishContainer">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="horizontal"
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    ads:constraint_referenced_ids="ivFinalScore"
                    ads:layout_constraintGuide_percent="0.2"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/containerScoreShare"
                    android:background="@drawable/selector_button_blue_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/size_layout_margin_top_10dp"
                    android:paddingEnd="@dimen/size_layout_margin_top_10dp"
                    android:layout_marginStart="@dimen/size_layout_margin_top_10dp"
                    android:layout_marginEnd="@dimen/size_layout_margin_top_10dp"
                    ads:layout_constraintEnd_toEndOf="parent"
                    ads:layout_constraintStart_toStartOf="parent"
                    ads:layout_constraintTop_toTopOf="@+id/guideline">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/llScoreShare"
                        android:paddingLeft="@dimen/size_layout_content_padding_top"
                        android:paddingRight="@dimen/size_layout_content_padding_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:layout_constraintEnd_toEndOf="parent"
                        ads:layout_constraintStart_toStartOf="parent"
                        ads:layout_constraintTop_toTopOf="parent">
                        <com.tebakgambar.component.CustomTextView
                            android:textSize="24sp"
                            android:textColor="@color/green_066F65"
                            android:gravity="center"
                            android:id="@+id/buttonScoreShare"
                            android:paddingRight="@dimen/size_layout_margin_top_10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/label_final_score"
                            ads:layout_constraintBottom_toBottomOf="parent"
                            ads:layout_constraintStart_toStartOf="parent"
                            ads:layout_constraintTop_toTopOf="parent"
                            ads:layout_constraintVertical_chainStyle="packed"
                            ads:typeface="avengeance"/>
                        <androidx.cardview.widget.CardView
                            android:background="@color/blue_1C5073"
                            android:paddingLeft="0dp"
                            android:paddingRight="18dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            ads:cardCornerRadius="5dp"
                            ads:layout_constraintStart_toEndOf="@+id/buttonScoreShare"
                            ads:layout_constraintTop_toTopOf="parent"
                            ads:layout_constraintVertical_chainStyle="packed">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:background="@color/blue_1C5073"
                                android:padding="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                ads:layout_constraintDimensionRatio="1:1">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_share_hint"
                                    ads:layout_constraintBottom_toBottomOf="parent"
                                    ads:layout_constraintEnd_toEndOf="parent"
                                    ads:layout_constraintStart_toStartOf="parent"
                                    ads:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.cardview.widget.CardView>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFinalScore"
                    android:visibility="gone"
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    ads:layout_constraintEnd_toEndOf="parent"
                    ads:layout_constraintStart_toStartOf="parent"
                    ads:layout_constraintTop_toTopOf="parent"
                    ads:srcCompat="@drawable/ic_final_score_star"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:id="@+id/tvShareScoreMessage"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_layout_margin_top_10dp"
                    android:text="@string/label_final_score_share"
                    ads:innerShadowColor="@color/color_yellow1"
                    ads:layout_constraintEnd_toEndOf="parent"
                    ads:layout_constraintStart_toStartOf="parent"
                    ads:layout_constraintTop_toBottomOf="@+id/containerScoreShare"
                    ads:strokeColor="@color/color_black"
                    ads:strokeJoinStyle="bevel"
                    ads:typeface="dimbo"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewInstruction"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                ads:layout_constraintDimensionRatio="5:6"
                ads:layout_constraintTop_toBottomOf="@+id/buttonCongrats"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.tebakgambar.component.CustomImageView
        android:id="@+id/imageAds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayoutNext"
        android:background="@color/color_dark_green_1"
        android:paddingLeft="@dimen/size_padding_wrapper_content"
        android:paddingRight="@dimen/size_padding_wrapper_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_layout_margin_top"
        android:weightSum="2"
        ads:layout_constraintBottom_toTopOf="@+id/frameAds"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent">
        <com.tebakgambar.component.CustomButton
            android:textSize="@dimen/size_text_button_green"
            android:textStyle="bold"
            android:textColor="@color/color_dark_green_1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/buttonNext"
            android:background="@drawable/selector_btn_hint"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_button_margin_top"
            android:layout_marginBottom="@dimen/size_button_margin_top"
            android:text="@string/button_question_next"
            android:maxLines="1"
            android:layout_weight="1"
            ads:innerShadowColor="@color/color_yellow1"
            ads:innerShadowRadius="2"
            ads:strokeJoinStyle="bevel"
            ads:typeface="dimbo"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
