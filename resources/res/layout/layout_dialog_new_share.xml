<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_dialog_new_share_0"
    android:background="@drawable/dialog_background_inset"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayoutWrapperContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewQuestion"
            android:paddingLeft="@dimen/size_layout_padding_left"
            android:paddingRight="@dimen/size_layout_padding_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_dialog_title"
            custom:typeface="dimbo"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/linearLayoutWrapperImage"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewQuestion">
            <RelativeLayout
                android:id="@+id/relativeLayoutImageViewFacebook"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imageViewFacebook"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_fb"/>
            </RelativeLayout>
            <View
                android:layout_width="4dp"
                android:layout_height="0dp"/>
            <RelativeLayout
                android:id="@+id/relativeLayoutImageViewTwitter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imageViewTwitter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_twitter"/>
            </RelativeLayout>
            <View
                android:layout_width="4dp"
                android:layout_height="0dp"/>
            <RelativeLayout
                android:id="@+id/relativeLayoutImageViewInstagram"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imageViewInstagram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_ig"/>
            </RelativeLayout>
            <View
                android:layout_width="4dp"
                android:layout_height="0dp"/>
            <RelativeLayout
                android:id="@+id/relativeLayoutImageViewOther"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imageViewOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_share"/>
            </RelativeLayout>
        </LinearLayout>
        <com.tebakgambar.component.CustomButton
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:id="@+id/buttonClose"
            android:background="@drawable/selector_button_orange_1"
            android:paddingLeft="12dp"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingRight="12dp"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_row_padding_right"
            android:text="@string/close"
            android:maxLines="1"
            android:layout_below="@+id/linearLayoutWrapperImage"
            android:layout_centerHorizontal="true"
            custom:typeface="dimbo"/>
    </RelativeLayout>
</RelativeLayout>
