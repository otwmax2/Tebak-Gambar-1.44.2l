<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayoutParentWrapper"
    android:tag="layout/activity_home_0"
    android:background="#f2f2f2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayoutGreetings"
        android:background="@color/color_dark_green_1"
        android:padding="@dimen/size_margin_top_button_main"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_hint"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            custom:typeface="dimbo"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relativeLayoutBGRepeat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/buttonLogin"
            android:tag="binding_1"
            android:layout_width="@dimen/size_button_sound"
            android:layout_height="@dimen/size_button_sound"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:layout_marginRight="@dimen/size_margin_top_bottom_button"
            android:src="@drawable/ic_no_login"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/buttonMessage"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="@dimen/size_button_sound"
            android:layout_height="@dimen/size_button_sound"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:layout_marginRight="@dimen/size_margin_top_bottom_button"
            android:layout_toLeftOf="@+id/buttonLogin"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/buttonSound"
            android:tag="binding_3"
            android:layout_width="@dimen/size_button_sound"
            android:layout_height="@dimen/size_button_sound"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:layout_marginRight="@dimen/size_margin_top_bottom_button"
            android:layout_toLeftOf="@+id/buttonMessage"
            android:layout_alignParentTop="true"/>
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/buttonAchievement"
            android:tag="binding_4"
            android:layout_width="@dimen/size_button_sound"
            android:layout_height="@dimen/size_button_sound"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:layout_marginRight="@dimen/size_margin_top_bottom_button"
            android:src="@drawable/btn_achievement_off"
            android:layout_toLeftOf="@+id/buttonSound"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="@dimen/size_button_height_number"
            android:layout_height="@dimen/size_button_height_number"
            android:layout_marginLeft="@dimen/size_margin_top_bottom_button"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:src="@drawable/ic_tebakgambar_logo"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/imageViewAvatar"
            android:tag="binding_5"
            android:clickable="true"
            android:layout_width="@dimen/size_layout_yellow_dialog_height"
            android:layout_height="@dimen/size_layout_yellow_dialog_height"
            android:src="@drawable/ic_sigam_default"
            android:adjustViewBounds="true"
            android:layout_below="@+id/imageViewLogo"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/linearLayoutRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_left_right_global"
            android:layout_marginRight="@dimen/size_margin_left_right_global"
            android:layout_below="@+id/imageViewAvatar">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonMain"
                android:tag="binding_6"
                android:background="@drawable/selector_button_orange_1"
                android:paddingTop="@dimen/size_padding_top_button_main"
                android:paddingBottom="@dimen/size_padding_bottom_button_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:text="@string/button_main"
                android:layout_weight="1"
                custom:typeface="avengeance"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonSelfie"
                android:tag="binding_7"
                android:background="@drawable/selector_button_red_1"
                android:paddingTop="@dimen/size_padding_top_button_main"
                android:paddingBottom="@dimen/size_padding_bottom_button_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_margin_sosial_media"
                android:text="@string/button_selfie"
                android:layout_weight="1"
                custom:typeface="avengeance"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/linearLayoutRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_left_right_global"
            android:layout_marginTop="@dimen/size_button_margin_top"
            android:layout_marginRight="@dimen/size_margin_left_right_global"
            android:layout_below="@+id/linearLayoutRow1">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonCaraMain"
                android:tag="binding_8"
                android:background="@drawable/selector_btn_sky"
                android:paddingTop="@dimen/size_padding_top_button_main"
                android:paddingBottom="@dimen/size_padding_bottom_button_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:text="@string/button_cara_bermain"
                android:layout_weight="1"
                custom:typeface="avengeance"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/buttonKirimSoal"
                android:tag="binding_9"
                android:background="@drawable/selector_button_blue_1"
                android:paddingTop="@dimen/size_padding_top_button_main"
                android:paddingBottom="@dimen/size_padding_bottom_button_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_margin_sosial_media"
                android:text="@string/button_kirim_soal"
                android:layout_weight="1"
                custom:typeface="avengeance"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/socmendLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_margin_top_bottom_button"
            android:layout_below="@+id/linearLayoutRow2">
            <com.tebakgambar.component.ClickableImageView
                android:id="@+id/buttonFacebook"
                android:tag="binding_10"
                android:layout_width="@dimen/size_button_sosial_media"
                android:layout_height="@dimen/size_button_sosial_media"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:src="@drawable/selector_fb"/>
            <com.tebakgambar.component.ClickableImageView
                android:id="@+id/buttonTwitter"
                android:tag="binding_11"
                android:layout_width="@dimen/size_button_sosial_media"
                android:layout_height="@dimen/size_button_sosial_media"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:src="@drawable/selector_twitter"/>
            <com.tebakgambar.component.ClickableImageView
                android:id="@+id/buttonInstagram"
                android:tag="binding_12"
                android:layout_width="@dimen/size_button_sosial_media"
                android:layout_height="@dimen/size_button_sosial_media"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:src="@drawable/selector_ig"/>
            <com.tebakgambar.component.ClickableImageView
                android:id="@+id/buttonLine"
                android:tag="binding_13"
                android:layout_width="@dimen/size_button_sosial_media"
                android:layout_height="@dimen/size_button_sosial_media"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:src="@drawable/selector_line"/>
        </LinearLayout>
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/imageViewStickerCampaign"
            android:tag="binding_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="60dp"
            android:layout_below="@+id/socmendLinearLayout"
            android:layout_centerHorizontal="true"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_button"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/textViewIntel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_left_right_global"
            android:layout_marginRight="@dimen/size_margin_left_right_global"
            android:layout_marginBottom="@dimen/size_margin_top_bottom_button"
            android:text="@string/label_optimized"
            android:layout_alignParentBottom="true"
            custom:typeface="captamerica"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_button_green"
            android:textColor="@color/color_black"
            android:gravity="center"
            android:id="@+id/textViewCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_margin_left_right_global"
            android:layout_marginTop="@dimen/size_margin_top_bottom_button"
            android:layout_marginRight="@dimen/size_margin_left_right_global"
            android:layout_marginBottom="5dp"
            android:text="@string/label_credit"
            android:layout_above="@+id/textViewIntel"
            android:layout_alignParentBottom="true"
            custom:typeface="captamerica"/>
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/imageViewDailyQuiz"
            android:tag="binding_15"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/size_margin_top_button_main"
            android:layout_marginRight="@dimen/size_margin_top_bottom_button"
            android:layout_marginBottom="64dp"
            android:src="@drawable/ic_daily_quiz_button"
            android:layout_above="@+id/textViewCopyright"
            android:layout_alignParentRight="true"/>
        <com.tebakgambar.component.ClickableImageView
            android:id="@+id/imageViewDailyQuizClose"
            android:tag="binding_16"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_daily_quiz_close_button"
            android:layout_alignTop="@+id/imageViewDailyQuiz"
            android:layout_alignRight="@+id/imageViewDailyQuiz"/>
    </RelativeLayout>
</RelativeLayout>
