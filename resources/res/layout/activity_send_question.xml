<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_send_question_0"
    android:background="@color/color_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/relativeLayoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_normal"/>
    <ScrollView
        android:id="@+id/scrollViewWrapper"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayoutWrapper"
            android:paddingLeft="@dimen/size_padding_wrapper_content"
            android:paddingTop="10dp"
            android:paddingRight="@dimen/size_padding_wrapper_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction_kirim_saran"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:id="@+id/textViewLabelKirimSoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                android:text="@string/label_kirim_soal"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomEditText
                android:textSize="@dimen/size_text_edittext_hint"
                android:textColor="@color/color_dark_green_1"
                android:id="@+id/editTextUsername"
                android:tag="binding_1"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:hint="@string/hint_kirim_soal_username"
                android:singleLine="true"
                android:inputType="textEmailSubject"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction"
                android:textColor="@color/color_red"
                android:id="@+id/textViewErrorUsername"
                android:tag="binding_2"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                ads:typeface="dimbo"/>
            <com.tebakgambar.component.CustomEditText
                android:textSize="@dimen/size_text_edittext_hint"
                android:textColor="@color/color_dark_green_1"
                android:id="@+id/editTextEmail"
                android:tag="binding_3"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:hint="@string/hint_kirim_soal_email"
                android:maxLines="1"
                android:inputType="textEmailSubject"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction"
                android:textColor="@color/color_red"
                android:id="@+id/textViewErrorEmail"
                android:tag="binding_4"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                ads:typeface="dimbo"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:layout_marginRight="@dimen/size_margin_sosial_media"
                    android:layout_weight="1">
                    <com.tebakgambar.component.CustomEditText
                        android:textSize="@dimen/size_text_edittext_hint"
                        android:textColor="@color/color_dark_green_1"
                        android:id="@+id/editTextJawabanSatu"
                        android:tag="binding_5"
                        android:background="@drawable/bg_rounded_white"
                        android:padding="@dimen/size_padding_wrapper_content_instruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_kirim_soal_jawaban_pertama"
                        android:maxLines="1"
                        android:inputType="textEmailSubject"
                        ads:typeface="avengeance"/>
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_text_instruction"
                        android:textColor="@color/color_red"
                        android:id="@+id/textViewErrorJawaban1"
                        android:tag="binding_6"
                        android:paddingLeft="@dimen/size_padding_button_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_margin_sosial_media"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:layout_weight="1">
                    <com.tebakgambar.component.CustomEditText
                        android:textSize="@dimen/size_text_edittext_hint"
                        android:textColor="@color/color_dark_green_1"
                        android:id="@+id/editTextJawabanDua"
                        android:tag="binding_7"
                        android:background="@drawable/bg_rounded_white"
                        android:padding="@dimen/size_padding_wrapper_content_instruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_kirim_soal_jawaban_kedua"
                        android:maxLines="1"
                        android:inputType="textEmailSubject"
                        ads:typeface="avengeance"/>
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_text_instruction"
                        android:textColor="@color/color_red"
                        android:id="@+id/textViewErrorJawaban2"
                        android:tag="binding_8"
                        android:paddingLeft="@dimen/size_padding_button_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                </LinearLayout>
            </LinearLayout>
            <com.tebakgambar.component.CustomEditText
                android:textSize="@dimen/size_text_edittext_hint"
                android:textColor="@color/color_dark_green_1"
                android:gravity="top|left"
                android:id="@+id/editTextDeskripsi"
                android:tag="binding_9"
                android:background="@drawable/bg_rounded_white"
                android:padding="@dimen/size_padding_wrapper_content_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:minHeight="@dimen/size_height_minimum"
                android:hint="@string/hint_kirim_soal_deskripsi"
                android:minLines="5"
                android:inputType="textMultiLine"
                ads:typeface="avengeance"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction"
                android:textColor="@color/color_red"
                android:id="@+id/textViewErrorDeskripsi"
                android:tag="binding_10"
                android:paddingLeft="@dimen/size_padding_button_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                ads:typeface="dimbo"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="@dimen/size_text_instruction_kirim_saran"
                android:textColor="@color/color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_button_bottom"
                android:text="@string/label_kirim_soal_captcha"
                ads:typeface="avengeance"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/size_margin_sosial_media"
                android:layout_marginEnd="@dimen/size_margin_sosial_media">
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_edittext_jawaban"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/textViewCaptcha"
                    android:tag="binding_11"
                    android:background="@color/color_dark_green_1"
                    android:padding="@dimen/size_padding_button_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:layout_marginRight="@dimen/size_padding_button_bottom"
                    ads:typeface="dimbo"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_padding_button_bottom"
                    android:layout_marginBottom="@dimen/size_padding_button_bottom">
                    <com.tebakgambar.component.CustomEditText
                        android:textSize="@dimen/size_text_edittext_hint"
                        android:textColor="@color/color_dark_green_1"
                        android:id="@+id/editTextCaptcha"
                        android:tag="binding_12"
                        android:background="@drawable/bg_rounded_white"
                        android:padding="@dimen/size_padding_wrapper_content_instruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_padding_button_bottom"
                        android:hint="@string/hint_kirim_soal_captcha"
                        android:maxLines="1"
                        android:inputType="textEmailSubject"
                        ads:typeface="avengeance"/>
                    <com.tebakgambar.component.CustomTextView
                        android:textSize="@dimen/size_text_instruction"
                        android:textColor="@color/color_red"
                        android:id="@+id/textViewErrorCaptcha"
                        android:tag="binding_13"
                        android:paddingLeft="@dimen/size_padding_button_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        ads:typeface="dimbo"/>
                </LinearLayout>
            </LinearLayout>
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_yellow1"
                android:gravity="center"
                android:id="@+id/buttonSendQuestion"
                android:tag="binding_14"
                android:background="@drawable/selector_button_green_1"
                android:paddingTop="@dimen/size_padding_button_bottom"
                android:paddingBottom="@dimen/size_padding_button_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_padding_wrapper_content_instruction"
                android:text="@string/button_kirim"
                ads:innerShadowColor="@color/color_yellow1"
                ads:innerShadowRadius="2"
                ads:strokeJoinStyle="bevel"
                ads:typeface="dimbo"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/frameAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
