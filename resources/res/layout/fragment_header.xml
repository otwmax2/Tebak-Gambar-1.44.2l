<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/color_dark_green_1"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_top_bar">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/linearLayoutWrapperHeart"
            android:padding="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="@null"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/imageViewHeart"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/imageViewBarBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="-14dp"
                    android:src="@drawable/bar_plus"
                    android:adjustViewBounds="true"/>
                <com.tebakgambar.component.CustomTextView
                    android:textSize="@dimen/size_text_top_textview_instruction"
                    android:textStyle="bold"
                    android:textColor="@color/color_dark_green_1"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textViewTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    custom:typeface="avengeance"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/imageViewHeart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/hati"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:src="@drawable/tebak_gambar_logo"
            android:adjustViewBounds="true"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
