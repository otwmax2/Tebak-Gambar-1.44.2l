<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/relativeLayoutRow"
    android:tag="layout/row_item_level_ad_unified_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/adView"
        android:background="@drawable/bg_item_level_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/size_row_margin_left_right"
        android:layout_marginTop="@dimen/size_row_margin_top"
        android:layout_marginRight="@dimen/size_row_margin_left_right">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_white"
            android:background="#fbb320"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageViewLevelIcon"
                android:layout_width="@dimen/size_row_unlock_width"
                android:layout_height="@dimen/size_row_unlock_height"
                android:src="@drawable/ic_sigam_ad"/>
            <com.tebakgambar.component.CustomTextView
                android:textSize="14sp"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:id="@+id/textViewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:layout_weight="1"/>
            <com.tebakgambar.component.CustomButton
                android:textSize="14sp"
                android:textColor="@color/color_dark_green_1"
                android:id="@+id/buttonAction"
                android:background="@drawable/bg_rounded_yellow"
                android:paddingLeft="4dp"
                android:paddingTop="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"/>
        </LinearLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</RelativeLayout>
