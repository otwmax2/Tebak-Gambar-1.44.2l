<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupContainer"
    android:tag="layout/layout_dialog_increase_life_0"
    android:background="@drawable/dialog_background_inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lifePopupQuestionWrapper"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.tebakgambar.component.CustomTextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/increase_life_title"
            custom:typeface="dimbo"/>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/bg_timer_increase_life"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.tebakgambar.component.CustomTextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_dark_green_1"
                android:layout_gravity="center_vertical"
                android:id="@+id/textViewTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                custom:typeface="avengeance"/>
        </LinearLayout>
        <com.tebakgambar.component.CustomButton
            android:textSize="22sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/buttonWatch"
            android:background="@drawable/selector_button_red_1"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_increase_life_see_ads"
            custom:typeface="dimbo"/>
        <LinearLayout
            android:gravity="center"
            android:paddingTop="@dimen/size_padding_button_bottom"
            android:paddingBottom="@dimen/size_padding_button_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:weightSum="5">
            <com.tebakgambar.component.CustomButton
                android:textSize="@dimen/size_text_button_green"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/buttonClose"
                android:background="@drawable/selector_button_green_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/close"
                android:maxLines="1"
                android:layout_weight="4"
                android:textFontWeight="1"
                custom:typeface="dimbo"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/successIncreaseLifeWrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="@dimen/size_width_button"
            android:layout_height="@dimen/size_width_button"
            android:src="@drawable/ic_sigam_bonus_nyawa"/>
    </LinearLayout>
</RelativeLayout>
