<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayoutWrapperContent"
        android:background="@drawable/bg_dialog_bantuan"
        android:paddingLeft="@dimen/size_layout_padding_left"
        android:paddingTop="@dimen/size_layout_padding_top"
        android:paddingRight="@dimen/size_layout_padding_right"
        android:paddingBottom="@dimen/size_layout_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_layout_height"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent">
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_dialog_title"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:gravity="center_horizontal"
            android:id="@+id/textViewLabelBantuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_bantuan"
            android:singleLine="true"
            custom:typeface="dimbo"/>
        <com.tebakgambar.component.CustomTextView
            android:textSize="@dimen/size_text_dialog_content"
            android:textColor="@color/color_black"
            android:gravity="center"
            android:id="@+id/textViewBantuan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/label_bantuan"
            android:layout_below="@+id/textViewLabelBantuan"
            custom:typeface="dimbo"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imageViewBantuan"
        android:layout_width="@dimen/size_sigam_story"
        android:layout_height="@dimen/size_sigam_story"
        android:layout_marginTop="@dimen/size_sigam_story_margin_top"
        android:src="@drawable/ic_sigam_quotes"
        android:layout_below="@+id/relativeLayoutWrapperContent"
        android:layout_centerHorizontal="true"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toBottomOf="@+id/relativeLayoutWrapperContent"/>
    <com.tebakgambar.component.CustomButton
        android:textSize="@dimen/size_text_button_green"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/buttonAds"
        android:background="@drawable/selector_button_orange_2"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:text="@string/label_hint_video"
        android:maxLines="1"
        android:layout_weight="2"
        android:layout_marginStart="@dimen/size_row_padding_20dp"
        android:layout_marginEnd="@dimen/size_row_padding_20dp"
        custom:innerShadowColor="@color/color_yellow1"
        custom:innerShadowRadius="2"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toBottomOf="@+id/relativeLayoutWrapperContent"
        custom:typeface="dimbo"/>
    <com.tebakgambar.component.CustomTextView
        android:textSize="8sp"
        android:textColor="@color/mau_beriklan"
        android:id="@+id/textAds"
        android:background="@drawable/bg_white_bottom_rounded_4dp"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ad"
        android:layout_marginStart="@dimen/size_layout_margin_top_10dp"
        android:layout_marginEnd="@dimen/size_layout_margin_top_10dp"
        android:elevation="5dp"
        custom:layout_constraintStart_toStartOf="@+id/buttonAds"
        custom:layout_constraintTop_toTopOf="@+id/buttonAds"/>
</androidx.constraintlayout.widget.ConstraintLayout>
