{
  "name": "tebak-gambar-telegram",
  "version": "1.2.0",
  "private": true,
  "description": "Standalone Telegram adaptation of the 400 bundled Tebak Gambar questions",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:verify": "tsx scripts/verify-assets.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run assets:verify && npm test && npm run build",
    "backup": "tsx scripts/backup.ts",
    "coverage:repo": "tsx scripts/map-repository.ts",
    "demo:test": "tsx scripts/test-demo-http.ts",
    "backup:compiled": "node dist/scripts/backup.js",
    "backup:test": "npm run build && tsx scripts/test-backup.ts",
    "doctor": "node dist/scripts/doctor.js",
    "doctor:offline": "node dist/scripts/doctor.js --offline",
    "test:mobile": "vitest run --maxWorkers=1 --no-file-parallelism --testTimeout=60000 --hookTimeout=60000",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "termux:prepare": "bash deploy/termux-prepare.sh",
    "termux:run": "bash deploy/termux-run.sh",
    "termux:launcher": "bash deploy/termux-launcher.sh"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "abort-controller": "3.0.0",
    "grammy": "1.46.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "packageManager": "npm@11.6.0"
}
