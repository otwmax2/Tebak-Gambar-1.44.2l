# Copy to bot/.env. NEVER commit the actual token or send it through chat.
BOT_TOKEN=
ADMIN_IDS=
DATABASE_PATH=./runtime/game.sqlite
# All paths are relative to bot/ (also when started elsewhere).
ASSET_ROOT=../audit/decrypted-levels
MAX_LIVES=5
LIFE_REFILL_SECONDS=600
INITIAL_HINTS=5
BOSS_SECONDS=60
DAILY_HINT_REWARD=2
DAILY_FREE_ANSWERS=1
SHUFFLE_QUESTIONS=true
RATE_LIMIT_MS=750
REMINDER_INTERVAL_SECONDS=30
# Optional HTTPS photo-frame helper uses the official Telegram file endpoint only.
PHOTO_MAX_BYTES=5242880

# Bot API request timeout; minimum 35s accommodates the 30s polling timeout.
API_TIMEOUT_SECONDS=45
